# MongoDB Configuration
# Connection URI for MongoDB
MONGODB_URI=mongodb://username:password@host:port

# Database name
MONGODB_DB_NAME=database_name

# Collection name for messages
MONGODB_COLLECTION_NAME=messages

# Collection name for states (optional, defaults to 'states')
MONGODB_STATE_COLLECTION=states

# DeepSeek API Configuration
# Your DeepSeek API key
DEEPSEEK_API_KEY=sk-your-api-key-here

# DeepSeek API URL (usually doesn't need to change)
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions

# Optional: Local development overrides
# LOCAL_MONGODB_URI=mongodb://localhost:27017
# LOCAL_MONGODB_DB_NAME=testdb

# Device Pairing — URL of the UI (used to open browser for first-time machine pairing)
UI_URL=http://localhost:3000

# Redis Pub/Sub (replaces MongoDB polling)
REDIS_URL=redis://localhost:6379
REDIS_CHANNEL=ai-worker:events
# REDIS_FALLBACK_POLL_INTERVAL=60   # seconds between fallback MongoDB scans (default: 60)

# Shared secret for encrypting per-user API keys (must match mongo-chat-ui's ENCRYPTION_KEY)
# Generate with: python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=base64-encoded-32-byte-key

# Collection storing per-user encrypted API keys (optional, defaults to 'apikeys')
MONGODB_API_KEYS_COLLECTION=apikeys